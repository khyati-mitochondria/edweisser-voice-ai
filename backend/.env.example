SARVAM_API_KEY=
ANTHROPIC_API_KEY=
COMPLAINT_NOTIFY_EMAIL=

# Which chat backend to use: "openai", "openrouter" (default) or "anthropic".
# (The Anthropic account is currently out of credits.)
LLM_PROVIDER=openrouter
# Used when LLM_PROVIDER=openai. gpt-4.1 was chosen for the most natural, colloquial
# Hindi and the best instruction-following. (gpt-5.4-mini writes every reply twice
# with this prompt on the chat-completions API; gpt-4o-mini's Hindi is stiff.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.1-flash

# Sarvam TTS voice. The persona's gender in the system prompt is derived from
# this (matters for Hindi etc., where a speaker's gender changes verb forms).
# Set PERSONA_GENDER=male|female only to override the derived value.
TTS_SPEAKER=ritu
